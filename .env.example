# Database Connection
# Add a `username:password` prefix (separated by `@`) before `localhost` when your
# local PostgreSQL requires password authentication.
DATABASE_URL="postgresql://localhost:5432/sylf"
DIRECT_URL="postgresql://localhost:5432/sylf"

# Authentication
JWT_SECRET="your-super-secret-jwt-key"

# AI Providers
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-120b"

# OAuth (Google)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email Verification (SMTP)
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
# Waitlist confirmation: auto preserves SMTP-first selection; select resend
# explicitly when migrating to a verified domain while SMTP remains configured.
WAITLIST_EMAIL_PROVIDER="auto"
# For Resend, set RESEND_API_KEY and WAITLIST_EMAIL_FROM on your verified domain.
# Never use onboarding@resend.dev or a Gmail address as a Resend sender.
# RESEND_API_KEY="..."
# WAITLIST_EMAIL_FROM="Sylf <hello@your-verified-domain.com>"
# WAITLIST_EMAIL_REPLY_TO="support@your-domain.com" # monitored removal-request inbox
# These waitlist overrides leave the existing authentication email sender intact.
# EMAIL_FROM and EMAIL_REPLY_TO remain available as fallbacks.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465" # 587 also supported; TLS is required

# ── Supabase Realtime (optional — presence + postgres_changes push) ──
# Without these the app keeps using REST polling + DB heartbeats.
# Project URL + anon key: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# "JWT secret" from the same page — used to mint Realtime tokens server-side.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
# After setting these, run scripts/db/supabase-realtime-setup.sql in the SQL editor.

# ── Upstash Redis (optional — hot-read cache layer) ──
# Without these the app uses an in-process fallback cache.
UPSTASH_REDIS_REST_URL="https://your-region.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-rest-token"

# ── Prelaunch Lockdown (set before publishing the landing page) ──
# When "true": all other page routes redirect to the landing page (including
# for existing signed-in users), and
# account creation (email + OAuth) is blocked with a 403. The waitlist
# signup flow keeps working normally. Set to "false" (or remove) to open
# the app up at public launch. Keep false locally for dev-server app access.
# Landing account links appear only in development; early-access CTAs stay public.
PRELAUNCH_MODE="false"

# ── Planner research search (optional — without one, research reports UNAVAILABLE) ──
# The Planner searches the web for a syllabus, then reads only the few highest-ranked
# pages. Supply at least one provider. With more than one configured they form a fallback
# chain: a quota error or an outage degrades to the next provider instead of failing.
# SEARCH_PROVIDER picks the first one explicitly ("brave" | "serper" | "searxng").
# With none set the order is Brave, then Serper, then SearXNG.
# SEARCH_PROVIDER="brave"
# BRAVE_SEARCH_API_KEY="your-brave-search-api-key"
# SERPER_API_KEY="your-serper-api-key"
# A self-hosted SearXNG instance. It must serve its JSON API (format=json); one instance
# fans out across several upstream engines, so it is the option that avoids depending on a
# single commercial provider. Only an absolute http(s) URL is accepted.
# SEARXNG_URL="https://searx.your-domain.example"

# ── Cron & Tool Confirmation (required — the app fails closed without them) ──
CRON_SECRET="your-random-cron-secret"
TOOL_CONFIRMATION_SECRET="your-random-tool-confirmation-secret"

# ── Unlimited AI / Planner entitlement (optional) ──
# Comma-separated Sylf User.id values (the autoincrement integer primary key of
# the User row — NOT an email, username, or UUID). ONLY these authenticated
# accounts bypass Sylf's APPLICATION-LEVEL AI quotas: AI chat, Classic Planner,
# Planner Modes (Exam / Roadmap / Mastery / Rebalance), syllabus compile, and
# scope evaluation. Every other account keeps its existing limits exactly.
#
# Leave this unset to grant nobody unlimited access (the safe default). A
# missing, empty, or malformed value grants nobody. Malformed entries are
# dropped; valid ones in the same list still apply.
#
# Server-only: never prefix this with NEXT_PUBLIC_. The value is read in
# lib/ai/entitlements.ts and is never exposed to the client bundle, and the
# entitlement is always resolved from the authenticated session, never from a
# request field.
# SYLF_UNLIMITED_AI_USER_IDS="123,456"

# External calendars (server only; never NEXT_PUBLIC_). See
# documentation/calendar/reports/phase-5/setup.md for provider registration.
# Use an HTTPS origin with a valid certificate and the Phase 5 deployment.
# CALENDAR_PUBLIC_URL="https://sylf-alium41rs-projects.vercel.app"
# Generate 32 random bytes encoded as base64; keep the same key across instances.
# CALENDAR_ENCRYPTION_KEY=""
# Optional dedicated Google app; falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.
# GOOGLE_CALENDAR_CLIENT_ID=""
# GOOGLE_CALENDAR_CLIENT_SECRET=""
# MICROSOFT_CALENDAR_CLIENT_ID=""
# MICROSOFT_CALENDAR_CLIENT_SECRET=""
# Reuses CRON_SECRET for GET /api/cron/calendar-sync every five minutes.

# Sylf Notes: metadata-only broker; never reuse calendar grants.
# Set an HTTPS origin and a persistent, separately backed-up 32-byte base64 key.
# NOTES_PUBLIC_URL="https://your-sylf-origin.example"
# NOTES_ENCRYPTION_KEY=""
# Optional dedicated Google OAuth client; otherwise existing GOOGLE_CLIENT_ID/SECRET.
# Register redirect: <NOTES_PUBLIC_URL>/api/notes/callback and enable Drive API.
# GOOGLE_NOTES_CLIENT_ID=""
# GOOGLE_NOTES_CLIENT_SECRET=""
