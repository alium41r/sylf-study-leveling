{
  "name": "@sylf/app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "EXPO_PUBLIC_SYLF_DEV_TOOLS=1 expo export --platform web --output-dir dist --clear",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "build:android": "npm run prebuild:android && cd android && EXPO_PUBLIC_SYLF_DEV_TOOLS=1 ./gradlew assembleRelease -PreactNativeArchitectures=${SYLF_ANDROID_ABIS:-arm64-v8a}",
    "install:android": "adb install -r android/app/build/outputs/apk/release/app-release.apk"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@sylf/backend": "*",
    "@sylf/design-system": "*",
    "@sylf/platform": "*",
    "@sylf/shared": "*",
    "@sylf/spaces": "*",
    "expo": "~58.0.21",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-secure-store": "~58.0.0",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "^0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0"
  }
}
