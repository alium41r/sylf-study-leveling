/**
 * A companion drawn by a scholar in Pixel Studio.
 * WHY A DEDICATED TABLE RATHER THAN `characterConfig`
 * Two reasons, and the first is the decisive one.
 * 1. **Size.** A creation is frames of pixels — up to 64 KB of authored data.
 * `characterConfig` is loaded on every stats fetch, is read by `useDashboardData`,
 * is embedded in conversation and profile payloads, and is selected by
 * queries across the app. Putting artwork in it would make every one of
 * those reads carry the artwork.
 * 2. **Ownership and lifecycle.** A creation is a thing a scholar *has*, in
 * possibly several instances, independent of what they currently wear.
 * `characterConfig` records a *choice*, which is why it references a
 * creation by id rather than containing it.
 * The artwork lives in `data` as a versioned JSON document rather than in columns,
 * because frames are a small, self-contained, always-read-together document whose
 * shape is owned by the Pixel Display contract — normalising frames into rows
 * would spread a content format across a schema and make every future version
 * bump a migration.
 */
model PixelCreation {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The creation's own slug, unique per scholar. Usable as a stable reference.
  slug      String
  /// Display name, echoed from the document for listing without decoding it.
  name      String
  /// The authored grid size, echoed for the same reason.
  grid      Int
  /// Format version of `data`, so a future format can be migrated rather than
  /// guessed at.
  revision  Int      @default(1)
  version   Int
  /// The whole `PixelCreation` document: palette, frames, timings, playback.
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slug])
  @@index([userId, updatedAt(sort: Desc)])
}

