// V2 adds only immutable intent versions and the durable Attempt/queue.
model PlannerIntentVersion {
  id         String                 @id @db.Uuid
  planId     String                 @db.Uuid
  userId     Int
  parentId   String?                @db.Uuid
  version    Int
  artifact   Json
  digest     String
  createdAt  DateTime               @default(now())
  plan       PlannerPlan            @relation("IntentPlan", fields: [planId], references: [id], onDelete: Cascade)
  workingFor PlannerPlan?           @relation("WorkingIntent")
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     PlannerIntentVersion?  @relation("IntentAncestry", fields: [parentId], references: [id], onDelete: NoAction)
  children   PlannerIntentVersion[] @relation("IntentAncestry")

  @@unique([planId, version])
  @@unique([id, planId])
}

model PlannerAttempt {
  id                  String            @id @db.Uuid
  userId              Int
  kind                String
  state               String
  requestKey          String
  requestHash         String
  fence               Int               @default(0)
  leaseOwner          String?
  leaseExpiresAt      DateTime?
  executionDeadlineAt DateTime?
  artifact            Json
  payload             Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions           PlannerRevision[]

  @@unique([userId, requestKey])
  @@index([state, createdAt])
  @@index([state, leaseExpiresAt])
  @@index([userId, kind, state])
}
