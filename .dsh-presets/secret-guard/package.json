{
  "name": "dsh-secret-guard",
  "version": "0.1.0",
  "description": "secret-guard: blocks agents from reading or writing sensitive files, masks leaked secret-shaped values in tool results, writes an audit journal, and exposes safe inspection tools. Compiled to JS for the DSH 0.2.0-rc.2 runtime, which refuses TypeScript type-stripping under node_modules.",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "security", "secrets", "guard", "redaction", "env"],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnXu22786/secret-guard.git"
  },
  "homepage": "https://github.com/JohnXu22786/secret-guard",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "schemastery": "^3.18.0"
  }
}
