generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum EffortLevel {
  RELAXED
  NORMAL
  INTENSE
  EXTREME
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum QuestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum QuestDifficulty {
  EASY
  NORMAL
  HARD
  EXPERT
}

enum SystemMessageType {
  INFO
  QUEST
  REWARD
  WARNING
  LEVEL_UP
  USER
  STREAK
  SYSTEM
  DAILY_BRIEFING
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum LedgerSource {
  QUEST
  TIMER
  LEVEL_UP
  SHOP
  SYSTEM
}

enum CosmeticCategory {
  THEME
  BACKGROUND
  AVATAR
  FRAME
  TITLE
  NAME_COLOR
}

enum PrivacyLevel {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum BriefingStatus {
  PENDING
  COMPLETED
  FAILED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  username          String             @unique
  password          String?
  name              String?
  scholarId         String?            @unique
  verificationStatus VerificationStatus @default(UNVERIFIED)
  avatarUrl         String?
  hunterRank        String             @default("E")
  level             Int       @default(1)
  currentXP         Int       @default(0)
  xpToNextLevel     Int       @default(200)
  hp                Int       @default(100)
  maxHp             Int       @default(100)
  streakDays        Int       @default(0)
  totalStudyMinutes Int       @default(0)
  totalStudySeconds Int       @default(0)
  lastActiveDate    String    @default("")
  lastSeenAt        DateTime?
  sylph             Int       @default(0)
  activeTheme       String    @default("default")
  activeBackground  String    @default("none")
  activeAvatar      String    @default("class_scholar")
  tokenVersion      Int       @default(1)
  activeFrame       String    @default("none")
  activeTitle       String    @default("Novice")
  activeNameColor   String    @default("default")
  activeAura        String    @default("none")
  bannerUrl         String?
  bio               String?
  characterConfig   Json?
  socialLinks       Json?

  // Academic Cognitive Stats Matrix (Attributes 0-100+)
  statEndurance     Int       @default(10) // END: Long-duration unbroken focus blocks (>60m)
  statTenacity      Int       @default(10) // TEN: Weekly streak stability & consistency
  statVelocity      Int       @default(10) // VEL: Daily quest & milestone completion throughput
  statSynthesis     Int       @default(10) // SYN: Problem sets & STEM deep work focus
  statDiscipline    Int       @default(10) // DIS: Punctuality, early start, low pause frequency

  createdAt         DateTime  @default(now())
  timezone          String    @default("UTC")
  hasCompletedOnboarding Boolean @default(false)

  goals          Goal[]
  quests         Quest[]
  sessions       StudySession[]
  systemMessages SystemMessage[]
  subjects       Subject[]
  inventoryItems InventoryItem[]
  sylphLedger    SylphLedger[]
  hpLedger       HpLedger[]
  chatSessions   ChatSession[]
  cosmetics      UserCosmetic[]
  achievements   UserAchievement[]
  privacy        UserPrivacy?
  connectedAccounts ConnectedAccount[]
  verificationTokens VerificationToken[]
  authSessions   AuthSession[]

  // AI
  aiMemories     AiMemory[]
  aiInsights     AiInsight[]
  dailyBriefings DailyBriefingLog[]

  // Social
  friendshipsAsUser   Friendship[]              @relation("friendshipsAsUser")
  friendshipsAsFriend Friendship[]              @relation("friendshipsAsFriend")
  sentRequests        FriendRequest[]           @relation("sentRequests")
  receivedRequests    FriendRequest[]           @relation("receivedRequests")
  conversations       ConversationParticipant[]
  messagesSent        Message[]
  sentInvites         SessionInvite[]           @relation("sentInvites")
  receivedInvites     SessionInvite[]           @relation("receivedInvites")

  @@index([currentXP, hunterRank])
}

model Goal {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetWeeks Int
  effortLevel EffortLevel @default(NORMAL)
  status      GoalStatus  @default(ACTIVE)
  createdAt   DateTime    @default(now())

  quests Quest[]
}

model Quest {
  id                 Int             @id @default(autoincrement())
  userId             Int
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId             Int?
  goal               Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  status             QuestStatus     @default(PENDING)
  difficulty         QuestDifficulty @default(NORMAL)
  requiredMinutes    Int
  elapsedSeconds     Int             @default(0)
  xpReward           Int
  sylphReward        Int             @default(0)
  isKamishWardActive Boolean         @default(false)
  isGateKeyApplied   Boolean         @default(false)
  scheduledFor       String // YYYY-MM-DD
  createdByAi        Boolean         @default(false)
  createdAt          DateTime        @default(now())
  completedAt        DateTime?

  sessions StudySession[]
}

model Subject {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?  @default("#7c3aed")
  createdAt DateTime @default(now())

  sessions StudySession[]
  invites  SessionInvite[]
}

model StudySession {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId         Int?
  quest           Quest?    @relation(fields: [questId], references: [id], onDelete: SetNull)
  subjectId       Int?
  subject         Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  durationMinutes Int
  durationSeconds Int       @default(0)
  focusRate       Int       @default(80) // Added for AI study planning
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
}

model SystemMessage {
  id            Int               @id @default(autoincrement())
  userId        Int
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     Int?
  session       ChatSession?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  content       String
  type          SystemMessageType
  read          Boolean           @default(false)
  attachmentUrl String? // Optional URL for uploaded files (images, pdfs, etc)
  createdAt     DateTime          @default(now())
}

model ChatSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SystemMessage[]
}

// ─── Social Models ───────────────────────────────────────────

model Friendship {
  id        Int      @id @default(autoincrement())
  userId    Int
  friendId  Int
  user      User     @relation("friendshipsAsUser", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("friendshipsAsFriend", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, friendId])
}

model FriendRequest {
  id         Int           @id @default(autoincrement())
  senderId   Int
  receiverId Int
  sender     User          @relation("sentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User          @relation("receivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  @@unique([senderId, receiverId])
}

model Conversation {
  id        Int      @id @default(autoincrement())
  name      String?
  isGroup   Boolean  @default(false)
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  userId         Int
  conversationId Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())

  @@unique([userId, conversationId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())
}

model SessionInvite {
  id         Int          @id @default(autoincrement())
  senderId   Int
  receiverId Int
  subjectId  Int?
  sender     User         @relation("sentInvites", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User         @relation("receivedInvites", fields: [receiverId], references: [id], onDelete: Cascade)
  subject    Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  status     InviteStatus @default(PENDING)
  createdAt  DateTime     @default(now())
}

// ─── Economy Models ──────────────────────────────────────────

model InventoryItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey   String // MONARCHS_DECREE, SHADOW_EXTRACTION, GATE_KEY, KAMISH_WARD, ELIXIR_OF_INSIGHT
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SylphLedger {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // Positive for income, negative for expense
  source    LedgerSource
  createdAt DateTime     @default(now())
}

model HpLedger {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int      // Negative for damage, positive for heal
  source    String   // e.g., "QUEST_FAILED", "ELIXIR"
  createdAt DateTime @default(now())
}

model UserCosmetic {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  CosmeticCategory
  itemKey   String // The unique identifier for the cosmetic
  createdAt DateTime         @default(now())

  @@unique([userId, category, itemKey])
}

model UserAchievement {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  claimedAt     DateTime @default(now())

  @@unique([userId, achievementId])
}

model UserPrivacy {
  id                  Int          @id @default(autoincrement())
  userId              Int          @unique
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileVisibility   PrivacyLevel @default(PUBLIC)
  showOnlineStatus    PrivacyLevel @default(PUBLIC)
  showCurrentSession  PrivacyLevel @default(PUBLIC)
  showStudyHours      PrivacyLevel @default(PUBLIC)
  showRank            PrivacyLevel @default(PUBLIC)
  showAchievements    PrivacyLevel @default(PUBLIC)

  allowFriendRequests PrivacyLevel @default(PUBLIC)
  allowDirectMessages PrivacyLevel @default(FRIENDS)
}

model ConnectedAccount {
  id                Int      @id @default(autoincrement())
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String // Google, GitHub, Discord, Instagram
  providerAccountId String // The unique ID given by the provider
  providerEmail     String? // The email associated with that specific provider

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1. Prevent one provider account from being linked to multiple users
  @@unique([provider, providerAccountId])
  // 2. Prevent one user from linking multiple accounts from the same provider
  @@unique([userId, provider])
}

// ─── AI Models ───────────────────────────────────────────────

model AiMemory {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String   // e.g., "exam_dates", "preferred_study_time", "career_goal"
  value      String   // JSON string for flexible storage
  confidence Float    @default(1.0) // How confident the AI is (0-1)
  source     String   @default("inferred") // "user_stated", "inferred", "observed"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, key])
}

model AiInsight {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String   // "coaching", "trend", "recommendation", "warning"
  content   String   // The insight text
  metadata  String?  // JSON with supporting data
  dismissed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DailyBriefingLog {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey   String         // "YYYY-MM-DD" in user's local time
  status    BriefingStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, dateKey])
}

model VerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  action    String   @default("VERIFY_EMAIL")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Acoustics & Soundscapes ──────────────────────────────────

model AcousticTrack {
  id            Int      @id @default(autoincrement())
  title         String
  category      String   // "BINAURAL", "NOISE", "AMBIENT", "LOFI"
  frequency     String?  // e.g. "40Hz Gamma", "10Hz Alpha", "Broadband"
  audioUrl      String   // URL or synthetic generator id (e.g. "synth:gamma-40", "synth:brown-noise")
  duration      Int      @default(0) // in seconds (0 = infinite ambient loop)
  defaultVolume Float    @default(0.75)
  description   String?
  tags          String[] @default([])
  isPreset      Boolean  @default(true)
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
}

model AuthSession {
  id           String    @id @default(cuid())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String?   @unique
  device       String    @default("Desktop Device")
  platform     String    @default("Web Browser")
  location     String    @default("Current Location")
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?

  @@index([userId])
}


