generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EffortLevel {
  RELAXED
  NORMAL
  INTENSE
  EXTREME
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum QuestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum QuestDifficulty {
  EASY
  NORMAL
  HARD
  EXPERT
}

enum SystemMessageType {
  INFO
  QUEST
  REWARD
  WARNING
  LEVEL_UP
  USER
  STREAK
  SYSTEM
  DAILY_BRIEFING
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum FocusTimerState {
  NOT_STARTED
  FOCUSING
  PAUSED
  LEFT
}

enum LedgerSource {
  QUEST
  TIMER
  LEVEL_UP
  SHOP
  SYSTEM
  ACHIEVEMENT
}

enum ItemCategory {
  CONSUMABLE
  EQUIPMENT
  WEAPON
  SET_BUNDLE
}

enum ItemSlot {
  HELMET
  CHESTPLATE
  PANTS
  BOOTS
  WEAPON
  RELIC
  NONE
}

enum ItemRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

enum CosmeticCategory {
  THEME
  BACKGROUND
  AVATAR
  FRAME
  TITLE
  NAME_COLOR
}

enum PrivacyLevel {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum BriefingStatus {
  PENDING
  COMPLETED
  FAILED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

model User {
  id                      Int                @id @default(autoincrement())
  email                   String             @unique
  username                String             @unique
  password                String?
  name                    String?
  scholarId               String?            @unique
  verificationStatus      VerificationStatus @default(UNVERIFIED)
  avatarUrl               String?
  hunterRank              String             @default("E")
  level                   Int                @default(1)
  currentXP               Int                @default(0)
  xpToNextLevel           Int                @default(182)
  hp                      Int                @default(100)
  maxHp                   Int                @default(100)
  streakDays              Int                @default(0)
  totalStudyMinutes       Int                @default(0)
  totalStudySeconds       Int                @default(0)
  lastActiveDate          String             @default("")
  lastSeenAt              DateTime?
  sylph                   Int                @default(0)
  activeTheme             String             @default("default")
  activeBackground        String             @default("none")
  activeAvatar            String             @default("class_scholar")
  tokenVersion            Int                @default(1)
  activeFrame             String             @default("none")
  activeTitle             String             @default("Novice")
  activeNameColor         String             @default("default")
  activeAura              String             @default("none")
  bannerUrl               String?
  bio                     String?
  characterConfig         Json?
  socialLinks             Json?
  isAdmin                 Boolean            @default(false)
  notificationPreferences Json?

  // Focus Timer Background Preference (Phase 4 & 5B)
  focusBackgroundSource            String               @default("classic") // 'classic' | 'official' | 'custom'
  selectedFocusBackgroundId        Int?
  selectedFocusBackground          FocusBackground?     @relation(fields: [selectedFocusBackgroundId], references: [id], onDelete: SetNull)
  selectedCustomBackgroundId       Int?
  selectedCustomBackground         UserFocusBackground? @relation("SelectedCustomBackground", fields: [selectedCustomBackgroundId], references: [id], onDelete: SetNull)
  focusBackgroundPreferenceVersion Int                  @default(0)

  // Academic Cognitive Stats Matrix (Attributes 0-100+)
  statEndurance  Int @default(10) // END: Long-duration unbroken focus blocks (>60m)
  statTenacity   Int @default(10) // TEN: Weekly streak stability & consistency
  statVelocity   Int @default(10) // VEL: Daily quest & milestone completion throughput
  statSynthesis  Int @default(10) // SYN: Problem sets & STEM deep work focus
  statDiscipline Int @default(10) // DIS: Punctuality, early start, low pause frequency

  createdAt              DateTime @default(now())
  timezone               String   @default("UTC")
  hasCompletedOnboarding Boolean  @default(false)

  // Study Schedule & Penalty Engine
  dailyGoalMinutes              Int     @default(120)
  restDays                      Int[]   @default([0]) // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  enableHpPenalty               Boolean @default(true)
  lastDailyPenaltyEvaluatedDate String  @default("")

  goals                 Goal[]
  quests                Quest[]
  sessions              StudySession[]
  timerStarts           TimerSessionStart[]
  systemMessages        SystemMessage[]
  subjects              Subject[]
  inventoryItems        InventoryItem[]
  inventory             UserInventory[]
  sylphLedger           SylphLedger[]
  hpLedger              HpLedger[]
  xpLedger              XpLedger[]
  userSkillNodes        UserSkillNode[]
  chatSessions          ChatSession[]
  cosmetics             UserCosmetic[]
  pixelCreations        PixelCreation[]
  achievements          UserAchievement[]
  privacy               UserPrivacy?
  connectedAccounts     ConnectedAccount[]
  verificationTokens    VerificationToken[]
  authSessions          AuthSession[]
  floatingRestDays      FloatingRestDay[]
  plannerPlans          PlannerPlan[]
  plannerIntentVersions PlannerIntentVersion[]
  plannerAttempts       PlannerAttempt[]
  plannerCheckResults   PlannerCheckResult[]
  plannerPreferences    PlannerPreference[]
  plannerFrictionEvents PlannerFrictionEvent[]
  plannerIntakeSessions PlannerIntakeSession[]

  // AI
  aiMemories     AiMemory[]
  aiInsights     AiInsight[]
  dailyBriefings DailyBriefingLog[]
  quotaUsage     UserQuota[]
  aiUsageLogs    AiUsageLog[]
  statInvests    StatInvestLedger[]

  // Social
  friendshipsAsUser   Friendship[]              @relation("friendshipsAsUser")
  friendshipsAsFriend Friendship[]              @relation("friendshipsAsFriend")
  blockedUsers        BlockedUser[]             @relation("blockedUsers")
  blockedByUsers      BlockedUser[]             @relation("blockedByUsers")
  sentRequests        FriendRequest[]           @relation("sentRequests")
  receivedRequests    FriendRequest[]           @relation("receivedRequests")
  conversations       ConversationParticipant[]
  messagesSent        Message[]
  sentInvites         SessionInvite[]           @relation("sentInvites")
  receivedInvites     SessionInvite[]           @relation("receivedInvites")
  ledParties          FocusParty[]              @relation("partyLeader")
  partyMemberships    FocusPartyMember[]
  sessionMemberships  FocusSessionMember[]

  // Progression & Cognitive Stats Engine
  stats UserStats?

  // Custom Focus Timer Backgrounds (Phase 5A)
  customFocusBackgrounds UserFocusBackground[] @relation("UserOwnedCustomBackgrounds")

  @@index([currentXP, hunterRank])
  @@index([selectedFocusBackgroundId])
  @@index([selectedCustomBackgroundId])
  @@index([focusBackgroundSource])
}

model UserStats {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       Int      @default(1)
  xp          Int      @default(0)
  rank        String   @default("RANK E")
  currency    Int      @default(0)
  skillPoints Int      @default(0)
  endurance   Int      @default(10) // END: Focus Stamina
  tenacity    Int      @default(10) // TEN: Streak Resilience
  velocity    Int      @default(10) // VEL: Pacing Speed
  discipline  Int      @default(10) // DIS: Daily Consistency
  synthesis   Int      @default(10) // SYN: Complex Output
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([level, xp])
}

model StatInvestLedger {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  statKey        String // endurance | tenacity | velocity | discipline | synthesis
  amount         Int // points granted (+5)
  currencyUsed   String // "sp" | "sylph"
  cost           Int // units spent
  statValueAfter Int // stat value after this invest
  createdAt      DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([statKey])
}

model Goal {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetWeeks Int
  effortLevel EffortLevel @default(NORMAL)
  status      GoalStatus  @default(ACTIVE)
  // Exact deadline (UTC). Representational midnight of the user-chosen date.
  targetDate  DateTime?
  // Objective accent preset token: EMERALD | CYAN | BLUE | VIOLET | ROSE | AMBER
  color       String      @default("EMERALD")
  createdAt   DateTime    @default(now())

  quests       Quest[]
  plannerPlans PlannerPlan[]

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, targetDate])
}

// ==========================================
// SUBJECT & CONSTELLATION PROGRESSION
// ==========================================

model Subject {
  id             Int       @id @default(autoincrement())
  userId         Int
  name           String // e.g., "A-Level Mathematics"
  code           String    @default("GENERAL") // e.g., "9709"
  examBoard      String    @default("CAIE") // e.g., "CAIE", "Edexcel", "AQA", "AP", "IB"
  level          String    @default("A-Level") // e.g., "A-Level", "AS-Level", "AP", "University"
  color          String    @default("#8B5CF6")
  syllabusNote   String? // Free-text book / syllabus details (used by the AI syllabus dissection)
  lastCompiledAt DateTime? // Set when the AI 48-node syllabus compilation commits (30-day recompile cooldown)
  archivedAt     DateTime? // Soft-delete timestamp for safe subject deletion
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes        SubjectNode[]
  quests       Quest[]
  sessions     StudySession[]
  invites      SessionInvite[]
  plannerPlans PlannerPlan[]

  @@unique([userId, code])
  @@index([userId, archivedAt])
}

model SubjectNode {
  id          Int       @id @default(autoincrement())
  subjectId   Int
  nodeId      String // Matches skeleton: "N1_1", "N2_1", ..., "N10_1"
  tier        Int // 1 to 10
  title       String // AI-generated syllabus topic name
  description String // Learning objectives / syllabus subtopics
  difficulty  Int // 1 to 5
  spAward     Int // T1-T3: 1, T4-T5: 2, T6-T7: 3, T8-T9: 4, T10: 0
  progress    Float     @default(0.0) // 0.0 to 100.0%
  isMastered  Boolean   @default(false)
  masteredAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  quests  Quest[]

  @@unique([subjectId, nodeId])
}

// ==========================================
// QUEST ENGINE EXTENSION
// ==========================================

model Quest {
  id                 Int             @id @default(autoincrement())
  userId             Int
  goalId             Int?
  subjectId          Int?
  subjectNodeId      Int?
  title              String
  description        String?
  targetMinutes      Int             @default(45)
  requiredMinutes    Int             @default(45)
  elapsedSeconds     Int             @default(0)
  scopeWeight        Float           @default(0.25) // Evaluated by AI: 0.05 to 1.00
  status             String          @default("ACTIVE") // "ACTIVE", "COMPLETED", "FAILED"
  difficulty         QuestDifficulty @default(NORMAL)
  scheduledFor       String          @default("") // YYYY-MM-DD
  isKamishWardActive Boolean         @default(false)
  isGateKeyApplied   Boolean         @default(false)
  createdByAi        Boolean         @default(false)
  xpReward           Int             @default(150)
  sylphReward        Int             @default(25)
  createdAt          DateTime        @default(now())
  completedAt        DateTime?

  user                                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal                                Goal?             @relation(fields: [goalId], references: [id], onDelete: SetNull)
  subject                             Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectNode                         SubjectNode?      @relation(fields: [subjectNodeId], references: [id], onDelete: SetNull)
  sessions                            StudySession[]
  plannerLink                         PlannerQuestLink?
  plannedMinutes                      Int?
  remainingMinutesEstimate            Int?
  remainingEstimateBasisActualSeconds Int?
  remainingDisposition                String            @default("OPEN")
  executionVersion                    Int               @default(0)
  plannerSpec                         Json?
  plannerSpecDigest                   String?

  @@index([userId, status])
  @@index([subjectNodeId])
  @@index([goalId])
}

// Planner snapshots and lineage only; Quest remains the execution model.
model PlannerPlan {
  id                     String                 @id @default(uuid()) @db.Uuid
  userId                 Int
  mode                   String
  title                  String
  state                  String                 @default("DRAFT")
  subjectId              Int?
  goalId                 Int?
  activeRevisionId       String?                @unique @db.Uuid
  latestDraftRevisionId  String?                @unique @db.Uuid
  version                Int                    @default(0)
  creationKey            String
  creationHash           String
  contractVersion        Int                    @default(1)
  workingIntentVersionId String?                @unique @db.Uuid
  conversationVersion    Int                    @default(0)
  conversation           Json?
  researchDocuments      Json?
  reservedGoalId         Int?                   @unique
  migrationEvidence      Json?
  intentVersions         PlannerIntentVersion[] @relation("IntentPlan")
  workingIntentVersion   PlannerIntentVersion?  @relation("WorkingIntent", fields: [workingIntentVersionId], references: [id], onDelete: NoAction)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject                Subject?               @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  goal                   Goal?                  @relation(fields: [goalId], references: [id], onDelete: SetNull)
  revisions              PlannerRevision[]      @relation("PlanRevisions")
  activeRevision         PlannerRevision?       @relation("ActiveRevision", fields: [activeRevisionId], references: [id], onDelete: NoAction)
  latestDraftRevision    PlannerRevision?       @relation("LatestDraft", fields: [latestDraftRevisionId], references: [id], onDelete: NoAction)
  links                  PlannerQuestLink[]
  checkResults           PlannerCheckResult[]
  preferences            PlannerPreference[]
  frictionEvents         PlannerFrictionEvent[]
  intakeSessions         PlannerIntakeSession[]

  @@unique([userId, creationKey])
  @@index([userId, state, createdAt])
  @@index([goalId])
  @@index([subjectId])
}

model PlannerRevision {
  id                       String                 @id @default(uuid()) @db.Uuid
  planId                   String                 @db.Uuid
  sequence                 Int
  source                   String
  baseRevisionId           String?                @db.Uuid
  baseVersion              Int
  schemaVersion            Int                    @default(1)
  attemptId                String?                @db.Uuid
  requestedIntentVersionId String?                @db.Uuid
  resolvedIntentVersionId  String?                @db.Uuid
  v2Artifact               Json?
  attempt                  PlannerAttempt?        @relation(fields: [attemptId], references: [id], onDelete: NoAction)
  inputSnapshot            Json
  availabilitySnapshot     Json
  outputSnapshot           Json?
  digest                   String?
  operationKey             String
  operationHash            String
  operationState           String                 @default("PREPARING")
  leaseExpiresAt           DateTime?
  quotaReceipt             Json?
  confirmationKey          String?
  confirmationHash         String?
  confirmationReceipt      Json?
  confirmedAt              DateTime?
  createdAt                DateTime               @default(now())
  sealedAt                 DateTime?
  updatedAt                DateTime               @updatedAt
  plan                     PlannerPlan            @relation("PlanRevisions", fields: [planId], references: [id], onDelete: Cascade)
  baseRevision             PlannerRevision?       @relation("RevisionBase", fields: [baseRevisionId], references: [id], onDelete: NoAction)
  childRevisions           PlannerRevision[]      @relation("RevisionBase")
  activeFor                PlannerPlan?           @relation("ActiveRevision")
  latestDraftFor           PlannerPlan?           @relation("LatestDraft")
  createdLinks             PlannerQuestLink[]     @relation("CreatedRevision")
  appliedLinks             PlannerQuestLink[]     @relation("AppliedRevision")
  frictionEvents           PlannerFrictionEvent[]

  @@unique([planId, sequence])
  @@unique([planId, operationKey])
  @@unique([planId, confirmationKey])
  @@unique([id, planId])
  @@index([operationState, leaseExpiresAt])
}

model PlannerQuestLink {
  id                 String          @id @default(uuid()) @db.Uuid
  planId             String          @db.Uuid
  itemKey            String          @db.Uuid
  questId            Int?            @unique
  createdRevisionId  String          @db.Uuid
  appliedRevisionId  String          @db.Uuid
  disposition        String          @default("LIVE")
  baseline           Json
  baselineSpecDigest String?
  changedAt          DateTime?
  removedAt          DateTime?
  removalReason      String?
  /// Released-work re-offer bookkeeping: OFFERED | ACCEPTED | DECLINED, or null.
  /// Never the release decision itself — that stays frozen by the row guard.
  reofferState       String?
  reofferedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  plan               PlannerPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  quest              Quest?          @relation(fields: [questId], references: [id], onDelete: SetNull)
  createdRevision    PlannerRevision @relation("CreatedRevision", fields: [createdRevisionId], references: [id], onDelete: NoAction)
  appliedRevision    PlannerRevision @relation("AppliedRevision", fields: [appliedRevisionId], references: [id], onDelete: NoAction)

  @@unique([planId, itemKey])
}

// User-reported Mastery Check reflection (Phase 5). One current, editable value
// per check item — deterministic, not append-only — so a second report replaces
// the first rather than accumulating history. It is private planner storage: RLS
// enabled and no client grants, and it deliberately carries no reflection text or
// score, only the fixed closed vocabulary the user chose.
model PlannerCheckResult {
  id         String      @id @default(uuid()) @db.Uuid
  planId     String      @db.Uuid
  userId     Int
  revisionId String      @db.Uuid
  itemKey    String      @db.Uuid
  result     String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  plan       PlannerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, itemKey])
  @@index([userId, planId])
}

// Learned planning preferences (Phase 6). One bounded, canonical value per
// (user, plan, type); a NULL planId means the preference applies to the user's
// planning in general. Learning is conservative: observations increment
// `evidenceCount` until they cross a threshold, or the user confirms explicitly
// (`lastConfirmedAt`). It is private planner storage — RLS enabled and no client
// grants — and deliberately carries no academic content (no topic/quest titles,
// no free text). See lib/planner/server/preferences.ts for the value encodings.
model PlannerPreference {
  id              String       @id @default(uuid()) @db.Uuid
  userId          Int
  planId          String?      @db.Uuid
  preferenceType  String
  value           String
  evidenceCount   Int          @default(0)
  confidence      Int          @default(0) // 0..100; 100 = explicitly confirmed
  lastConfirmedAt DateTime?
  ignoredAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            PlannerPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, planId, preferenceType])
  @@index([userId, planId])
  @@index([userId, preferenceType])
}

// One optional, user-reported friction reason attached to a planner draft item
// (Phase 6). `itemKey` is the planner draft item key — a canonical lowercase
// UUID, deliberately NOT a Quest id. There is deliberately no free-text note
// column: the closed reason code is the whole signal. Private planner storage:
// RLS enabled, no client grants.
model PlannerFrictionEvent {
  id         String           @id @default(uuid()) @db.Uuid
  planId     String           @db.Uuid
  revisionId String?          @db.Uuid
  itemKey    String
  userId     Int
  reasonCode String
  createdAt  DateTime         @default(now())
  plan       PlannerPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  revision   PlannerRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planId, revisionId, itemKey, reasonCode])
  @@index([planId])
  @@index([userId, createdAt])
}

// Pre-generation planner intake state (UX Phase 1): the working "Plan Brief" a
// student builds before generation starts. It lives beside the engine, never in
// a revision snapshot, so a page refresh cannot lose an in-progress Quick Plan.
// Owner-scoped through `userId`; `(userId, clientKey)` makes create idempotent;
// `version` is optimistic concurrency; `planId` is set once generation begins and
// is SetNull (never Cascade) so a plan survives intake expiry/cleanup. The brief
// is bounded by the server module on write (64 KiB), not by the column. Private
// planner storage: RLS enabled, no client grants.
model PlannerIntakeSession {
  id        String       @id @default(uuid()) @db.Uuid
  userId    Int
  clientKey String
  mode      String
  brief     Json
  version   Int          @default(0)
  planId    String?      @db.Uuid
  expiresAt DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      PlannerPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@unique([userId, clientKey])
  @@index([userId, updatedAt])
  @@index([expiresAt])
}

model StudySession {
  id                    Int       @id @default(autoincrement())
  userId                Int
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId               Int?
  quest                 Quest?    @relation(fields: [questId], references: [id], onDelete: SetNull)
  subjectId             Int?
  subject               Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  durationMinutes       Int
  durationSeconds       Int       @default(0)
  breakSeconds          Int       @default(0) // break/rest time inside this session — NEVER counted as study time
  focusRate             Int       @default(80) // Added for AI study planning
  rewardsClaimed        Boolean   @default(false) // Quest rewards claimed via claim_session_reward_atomic
  startedAt             DateTime  @default(now())
  endedAt               DateTime?
  executionState        String?
  executionVersion      Int       @default(0)
  transitionReceipts    Json?
  executionContext      Json?
  runningSince          DateTime?
  acceptedFocusAtResume Int       @default(0)
  acceptedBreakAtResume Int       @default(0)
  timerStarts           TimerSessionStart[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, questId])
  @@index([userId, subjectId])
}

// Durable creation receipts keep a lost POST response replayable after END.
model TimerSessionStart {
  userId      Int
  clientKey   String
  requestHash String
  sessionId   Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@id([userId, clientKey])
  @@index([sessionId])
}

model SystemMessage {
  id            Int               @id @default(autoincrement())
  userId        Int
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     Int?
  session       ChatSession?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  content       String
  type          SystemMessageType
  read          Boolean           @default(false)
  attachmentUrl String? // Optional URL for uploaded files (images, pdfs, etc)
  /// Engine/model that produced this reply (e.g. "DEEPSEEK (deepseek-v4-flash)",
  /// "Deterministic (no LLM)"). Kept out of the content so it never renders.
  modelUsed     String?
  createdAt     DateTime          @default(now())

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([userId, sessionId])
}

model ChatSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SystemMessage[]

  @@index([userId, updatedAt(sort: Desc)])
}

// ─── Social Models ───────────────────────────────────────────

model Friendship {
  id        Int      @id @default(autoincrement())
  userId    Int
  friendId  Int
  user      User     @relation("friendshipsAsUser", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("friendshipsAsFriend", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, friendId])
  @@index([friendId, userId])
}

model BlockedUser {
  id        Int      @id @default(autoincrement())
  userId    Int
  blockedId Int
  user      User     @relation("blockedUsers", fields: [userId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, blockedId])
}

model FriendRequest {
  id         Int           @id @default(autoincrement())
  senderId   Int
  receiverId Int
  sender     User          @relation("sentRequests", fields: [senderId], references: [id], onDelete: Cascade)
