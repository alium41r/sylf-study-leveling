// ==========================================
// FLOATING REST DAYS (Ad-hoc / Irregular Rest)
// ==========================================
// Users may designate ONE ad-hoc rest day per ISO week for unplanned
// events, sickness, or family commitments. Floating rest days:
//  - hard-block quest allocation (manual UI, API, and AI paths)
//  - trigger the automatic quest-shifting cascade on designation
//  - fully exempt the day from HP penalties / daily target evaluation

model FloatingRestDay {
  id        Int      @id @default(autoincrement())
  userId    Int
  dateKey   String // "YYYY-MM-DD"
  weekKey   String // "YYYY-Www" ISO week key for O(1) weekly quota checks
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([userId, weekKey])
}

