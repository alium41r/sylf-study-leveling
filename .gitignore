# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Keep the documented, secret-free template in version control.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# database
dev.db

# vim swap files
*.swp
*.swo
# S4: never commit database dumps, user uploads, or debug artifacts
backups/
backup_*
/public/uploads/
/public/chat_error.log
repomix-output.md
scratch/
*.log

# CodeGraph local index (see codegraph.json)
/.cg/

# Local agent harness state and cached presets (not project source).
/.dsh-presets/
/.playwright-mcp/

# Generated build output (rebuild with npm scripts; never commit).
/dist/
/mobile/dist/

# Android / Capacitor native builds
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
*.aab
*.keystore
*.jks
.idea/
android/.idea/
android/*.iml
android/app/*.iml
android/captures/

# Reproducible optional handwriting worker/WASM assets.
/public/calendar-recognition/
