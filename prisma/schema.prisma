generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EffortLevel {
  RELAXED
  NORMAL
  INTENSE
  EXTREME
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum QuestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum QuestDifficulty {
  EASY
  NORMAL
  HARD
  EXPERT
}

enum SystemMessageType {
  INFO
  QUEST
  REWARD
  WARNING
  LEVEL_UP
  USER
  STREAK
  SYSTEM
  DAILY_BRIEFING
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum LedgerSource {
  QUEST
  TIMER
  LEVEL_UP
  SHOP
  SYSTEM
  ACHIEVEMENT
}

enum ItemCategory {
  CONSUMABLE
  EQUIPMENT
  WEAPON
  SET_BUNDLE
}

enum ItemSlot {
  HELMET
  CHESTPLATE
  PANTS
  BOOTS
  WEAPON
  RELIC
  NONE
}

enum ItemRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}


enum CosmeticCategory {
  THEME
  BACKGROUND
  AVATAR
  FRAME
  TITLE
  NAME_COLOR
}

enum PrivacyLevel {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum BriefingStatus {
  PENDING
  COMPLETED
  FAILED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

model User {
  id                      Int                @id @default(autoincrement())
  email                   String             @unique
  username                String             @unique
  password                String?
  name                    String?
  scholarId               String?            @unique
  verificationStatus      VerificationStatus @default(UNVERIFIED)
  avatarUrl               String?
  hunterRank              String             @default("E")
  level                   Int                @default(1)
  currentXP               Int                @default(0)
  xpToNextLevel           Int                @default(182)
  hp                      Int                @default(100)
  maxHp                   Int                @default(100)
  streakDays              Int                @default(0)
  totalStudyMinutes       Int                @default(0)
  totalStudySeconds       Int                @default(0)
  lastActiveDate          String             @default("")
  lastSeenAt              DateTime?
  sylph                   Int                @default(0)
  activeTheme             String             @default("default")
  activeBackground        String             @default("none")
  activeAvatar            String             @default("class_scholar")
  tokenVersion            Int                @default(1)
  activeFrame             String             @default("none")
  activeTitle             String             @default("Novice")
  activeNameColor         String             @default("default")
  activeAura              String             @default("none")
  bannerUrl               String?
  bio                     String?
  characterConfig         Json?
  socialLinks             Json?
  notificationPreferences Json?

  // Academic Cognitive Stats Matrix (Attributes 0-100+)
  statEndurance  Int @default(10) // END: Long-duration unbroken focus blocks (>60m)
  statTenacity   Int @default(10) // TEN: Weekly streak stability & consistency
  statVelocity   Int @default(10) // VEL: Daily quest & milestone completion throughput
  statSynthesis  Int @default(10) // SYN: Problem sets & STEM deep work focus
  statDiscipline Int @default(10) // DIS: Punctuality, early start, low pause frequency

  createdAt              DateTime @default(now())
  timezone               String   @default("UTC")
  hasCompletedOnboarding Boolean  @default(false)

  // Study Schedule & Penalty Engine
  dailyGoalMinutes              Int     @default(120)
  restDays                      Int[]   @default([0]) // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  enableHpPenalty               Boolean @default(true)
  lastDailyPenaltyEvaluatedDate String  @default("")

  goals              Goal[]
  quests             Quest[]
  sessions           StudySession[]
  systemMessages     SystemMessage[]
  subjects           Subject[]
  inventoryItems     InventoryItem[]
  inventory          UserInventory[]
  sylphLedger        SylphLedger[]
  hpLedger           HpLedger[]
  xpLedger           XpLedger[]
  userSkillNodes     UserSkillNode[]
  chatSessions       ChatSession[]
  cosmetics          UserCosmetic[]
  achievements       UserAchievement[]
  privacy            UserPrivacy?
  connectedAccounts  ConnectedAccount[]
  verificationTokens VerificationToken[]
  authSessions       AuthSession[]
  floatingRestDays   FloatingRestDay[]

  // AI
  aiMemories     AiMemory[]
  aiInsights     AiInsight[]
  dailyBriefings DailyBriefingLog[]
  quotaUsage     UserQuota[]
  aiUsageLogs    AiUsageLog[]

  // Social
  friendshipsAsUser   Friendship[]              @relation("friendshipsAsUser")
  friendshipsAsFriend Friendship[]              @relation("friendshipsAsFriend")
  blockedUsers        BlockedUser[]             @relation("blockedUsers")
  blockedByUsers      BlockedUser[]             @relation("blockedByUsers")
  sentRequests        FriendRequest[]           @relation("sentRequests")
  receivedRequests    FriendRequest[]           @relation("receivedRequests")
  conversations       ConversationParticipant[]
  messagesSent        Message[]
  sentInvites         SessionInvite[]           @relation("sentInvites")
  receivedInvites     SessionInvite[]           @relation("receivedInvites")

  // Progression & Cognitive Stats Engine
  stats UserStats?

  @@index([currentXP, hunterRank])
}

model UserStats {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       Int      @default(1)
  xp          Int      @default(0)
  rank        String   @default("RANK E")
  currency    Int      @default(0)
  skillPoints Int      @default(0)
  endurance   Int      @default(10) // END: Focus Stamina
  tenacity    Int      @default(10) // TEN: Streak Resilience
  velocity    Int      @default(10) // VEL: Pacing Speed
  discipline  Int      @default(10) // DIS: Daily Consistency
  synthesis   Int      @default(10) // SYN: Complex Output
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([level, xp])
}

model Goal {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetWeeks Int
  effortLevel EffortLevel @default(NORMAL)
  status      GoalStatus  @default(ACTIVE)
  // Exact deadline (UTC). Representational midnight of the user-chosen date.
  targetDate  DateTime?
  // Objective accent preset token: EMERALD | CYAN | BLUE | VIOLET | ROSE | AMBER
  color       String      @default("EMERALD")
  createdAt   DateTime    @default(now())

  quests Quest[]

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, targetDate])
}

// ==========================================
// SUBJECT & CONSTELLATION PROGRESSION
// ==========================================

model Subject {
  id           Int           @id @default(autoincrement())
  userId       Int
  name         String        // e.g., "A-Level Mathematics"
  code         String        @default("GENERAL") // e.g., "9709"
  examBoard    String        @default("CAIE")    // e.g., "CAIE", "Edexcel", "AQA", "AP", "IB"
  level        String        @default("A-Level") // e.g., "A-Level", "AS-Level", "AP", "University"
  color        String        @default("#8B5CF6")
  syllabusNote String?       // Free-text book / syllabus details (used by the AI syllabus dissection)
  lastCompiledAt DateTime?   // Set when the AI 48-node syllabus compilation commits (30-day recompile cooldown)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes        SubjectNode[]
  quests       Quest[]
  sessions     StudySession[]
  invites      SessionInvite[]

  @@unique([userId, code])
}

model SubjectNode {
  id           Int       @id @default(autoincrement())
  subjectId    Int
  nodeId       String    // Matches skeleton: "N1_1", "N2_1", ..., "N10_1"
  tier         Int       // 1 to 10
  title        String    // AI-generated syllabus topic name
  description  String    // Learning objectives / syllabus subtopics
  difficulty   Int       // 1 to 5
  spAward      Int       // T1-T3: 1, T4-T5: 2, T6-T7: 3, T8-T9: 4, T10: 0
  progress     Float     @default(0.0) // 0.0 to 100.0%
  isMastered   Boolean   @default(false)
  masteredAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  subject      Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  quests       Quest[]

  @@unique([subjectId, nodeId])
}

// ==========================================
// QUEST ENGINE EXTENSION
// ==========================================

model Quest {
  id                 Int             @id @default(autoincrement())
  userId             Int
  goalId             Int?
  subjectId          Int?
  subjectNodeId      Int?
  title              String
  description        String?
  targetMinutes      Int             @default(45)
  requiredMinutes    Int             @default(45)
  elapsedSeconds     Int             @default(0)
  scopeWeight        Float           @default(0.25) // Evaluated by AI: 0.05 to 1.00
  status             String          @default("ACTIVE") // "ACTIVE", "COMPLETED", "FAILED"
  difficulty         QuestDifficulty @default(NORMAL)
  scheduledFor       String          @default("") // YYYY-MM-DD
  isKamishWardActive Boolean         @default(false)
  isGateKeyApplied   Boolean         @default(false)
  createdByAi        Boolean         @default(false)
  xpReward           Int             @default(150)
  sylphReward        Int             @default(25)
  createdAt          DateTime        @default(now())
  completedAt        DateTime?

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal               Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  subject            Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectNode        SubjectNode?    @relation(fields: [subjectNodeId], references: [id], onDelete: SetNull)
  sessions           StudySession[]

  @@index([userId, status])
  @@index([subjectNodeId])
  @@index([goalId])
}

model StudySession {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId         Int?
  quest           Quest?    @relation(fields: [questId], references: [id], onDelete: SetNull)
  subjectId       Int?
  subject         Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  durationMinutes Int
  durationSeconds Int       @default(0)
  breakSeconds     Int       @default(0) // break/rest time inside this session — NEVER counted as study time
  focusRate       Int       @default(80) // Added for AI study planning
  rewardsClaimed  Boolean   @default(false) // Quest rewards claimed via claim_session_reward_atomic
  startedAt       DateTime  @default(now())
  endedAt         DateTime?

  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, questId])
  @@index([userId, subjectId])
}

model SystemMessage {
  id            Int               @id @default(autoincrement())
  userId        Int
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     Int?
  session       ChatSession?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  content       String
  type          SystemMessageType
  read          Boolean           @default(false)
  attachmentUrl String? // Optional URL for uploaded files (images, pdfs, etc)
  /// Engine/model that produced this reply (e.g. "DEEPSEEK (deepseek-v4-flash)",
  /// "Deterministic (no LLM)"). Kept out of the content so it never renders.
  modelUsed     String?
  createdAt     DateTime          @default(now())

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([userId, sessionId])
}

model ChatSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SystemMessage[]

  @@index([userId, updatedAt(sort: Desc)])
}

// ─── Social Models ───────────────────────────────────────────

model Friendship {
  id        Int      @id @default(autoincrement())
  userId    Int
  friendId  Int
  user      User     @relation("friendshipsAsUser", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("friendshipsAsFriend", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, friendId])
  @@index([friendId, userId])
}

model BlockedUser {
  id        Int      @id @default(autoincrement())
  userId    Int
  blockedId Int
  user      User     @relation("blockedUsers", fields: [userId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, blockedId])
}

model FriendRequest {
  id         Int           @id @default(autoincrement())
  senderId   Int
  receiverId Int
  sender     User          @relation("sentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User          @relation("receivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Conversation {
  id        Int      @id @default(autoincrement())
  name      String?
  avatarUrl String?
  isGroup   Boolean  @default(false)
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  userId         Int
  conversationId Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())

  @@unique([userId, conversationId])
  @@index([conversationId, userId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt(sort: Asc)])
  @@index([senderId])
}

model SessionInvite {
  id         Int          @id @default(autoincrement())
  senderId   Int
  receiverId Int
  subjectId  Int?
  sender     User         @relation("sentInvites", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User         @relation("receivedInvites", fields: [receiverId], references: [id], onDelete: Cascade)
  subject    Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  status     InviteStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@index([receiverId, status])
  @@index([senderId, status])
}

// ─── Economy Models ──────────────────────────────────────────

model Item {
  id              Int          @id @default(autoincrement())
  sku             String       @unique
  name            String
  description     String
  category        ItemCategory
  slot            ItemSlot     @default(NONE)
  rarity          ItemRarity   @default(COMMON)
  rankRequirement String       @default("RANK E")
  costSylph       Int          @default(0)
  effectPayload   Json         @default("{}")
  spriteLayer     String?
  setKey          String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  inventories UserInventory[]

  @@index([category, rankRequirement])
  @@index([rarity])
  @@index([setKey])
}

model UserInventory {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     Int
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  isEquipped Boolean  @default(false)
  acquiredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, itemId])
  @@index([userId, isEquipped])
}


model InventoryItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey   String // MONARCHS_DECREE, SHADOW_EXTRACTION, GATE_KEY, KAMISH_WARD, ELIXIR_OF_INSIGHT
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, itemKey])
}

model SylphLedger {
  id           Int          @id @default(autoincrement())
  userId       Int
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int          @default(0) // Positive for income, negative for expense
  delta        Int          @default(0)
  balanceAfter Int          @default(0)
  reason       String       @default("")
  source       LedgerSource @default(SYSTEM)
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model HpLedger {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // Negative for damage, positive for heal
  source    String // e.g., "QUEST_FAILED", "ELIXIR"
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model XpLedger {
  id           Int          @id @default(autoincrement())
  userId       Int
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int          @default(0) // Positive for income, negative for expense
  balanceAfter Int          @default(0) // Lifetime total XP after this entry
  reason       String       @default("")
  source       LedgerSource @default(SYSTEM)
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model UserSkillNode {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeKey    String // Fully-qualified key, e.g. "SCHOLAR_N2_1"
  unlockedAt DateTime @default(now())

  @@unique([userId, nodeKey])
  @@index([userId])
}

model UserQuota {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   String // "chat" | "planner" | "compile"
  dateKey   String // YYYY-MM-DD in the user's timezone
  used      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, feature, dateKey])
  @@index([userId])
}

/// Request-level AI cost telemetry: every successful LLM generation is
/// recorded with token counts and an estimated USD cost so the owner can
/// see where the API balance actually goes. Diagnostic-only.
model AiUsageLog {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature          String // "chat" | "planner" | "syllabus" | "other"
  workload         String? // agent-router workload (e.g. "simple", "general_chat")
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  cacheHitTokens   Int      @default(0) // input tokens served from DeepSeek's context cache
  estimatedCostUsd Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

model UserCosmetic {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  CosmeticCategory
  itemKey   String // The unique identifier for the cosmetic
  createdAt DateTime         @default(now())

  @@unique([userId, category, itemKey])
  @@index([userId, category])
}

model UserAchievement {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  claimedAt     DateTime @default(now())

  @@unique([userId, achievementId])
  @@index([userId, claimedAt(sort: Desc)])
}

model UserPrivacy {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileVisibility  PrivacyLevel @default(PUBLIC)
  showOnlineStatus   PrivacyLevel @default(PUBLIC)
  showCurrentSession PrivacyLevel @default(PUBLIC)
  showStudyHours     PrivacyLevel @default(PUBLIC)
  showRank           PrivacyLevel @default(PUBLIC)
  showAchievements   PrivacyLevel @default(PUBLIC)

  allowFriendRequests PrivacyLevel @default(PUBLIC)
  allowDirectMessages PrivacyLevel @default(FRIENDS)
}

model ConnectedAccount {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String // Google, GitHub, Discord, Instagram
  providerAccountId String // The unique ID given by the provider
  providerEmail     String? // The email associated with that specific provider
  providerUsername  String? // The username/handle on the provider platform (e.g. GitHub login, Discord username)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1. Prevent one provider account from being linked to multiple users
  @@unique([provider, providerAccountId])
  // 2. Prevent one user from linking multiple accounts from the same provider
  @@unique([userId, provider])
}

// ─── AI Models ───────────────────────────────────────────────

model AiMemory {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String // e.g., "exam_dates", "preferred_study_time", "career_goal"
  value      String // JSON string for flexible storage
  confidence Float    @default(1.0) // How confident the AI is (0-1)
  source     String   @default("inferred") // "user_stated", "inferred", "observed"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId, confidence(sort: Desc)])
}

model AiInsight {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String // "coaching", "trend", "recommendation", "warning"
  content   String // The insight text
  metadata  String? // JSON with supporting data
  dismissed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, dismissed, createdAt(sort: Desc)])
}

model DailyBriefingLog {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey   String // "YYYY-MM-DD" in user's local time
  status    BriefingStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, dateKey])
}

model VerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  action    String   @default("VERIFY_EMAIL")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Acoustics & Soundscapes ──────────────────────────────────

model AcousticTrack {
  id            Int      @id @default(autoincrement())
  title         String
  category      String // "BINAURAL", "NOISE", "AMBIENT", "LOFI"
  frequency     String? // e.g. "40Hz Gamma", "10Hz Alpha", "Broadband"
  audioUrl      String // URL or synthetic generator id (e.g. "synth:gamma-40", "synth:brown-noise")
  duration      Int      @default(0) // in seconds (0 = infinite ambient loop)
  defaultVolume Float    @default(0.75)
  description   String?
  tags          String[] @default([])
  isPreset      Boolean  @default(true)
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category, orderIndex])
}

model AuthSession {
  id           String    @id @default(cuid())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String?   @unique
  device       String    @default("Desktop Device")
  platform     String    @default("Web Browser")
  location     String    @default("Current Location")
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?

  @@index([userId, lastActiveAt(sort: Desc)])
}

// ==========================================
// FLOATING REST DAYS (Ad-hoc / Irregular Rest)
// ==========================================
// Users may designate ONE ad-hoc rest day per ISO week for unplanned
// events, sickness, or family commitments. Floating rest days:
//  - hard-block quest allocation (manual UI, API, and AI paths)
//  - trigger the automatic quest-shifting cascade on designation
//  - fully exempt the day from HP penalties / daily target evaluation

model FloatingRestDay {
  id        Int      @id @default(autoincrement())
  userId    Int
  dateKey   String // "YYYY-MM-DD"
  weekKey   String // "YYYY-Www" ISO week key for O(1) weekly quota checks
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([userId, weekKey])
}

// ─── Pre-Launch Waitlist ──────────────────────────────────────
model WaitlistEntry {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  name          String?
  targetExam    String?  // e.g. "MCAT", "USMLE", "A-Levels", "AP Exams", "Computer Science", "Engineering", "General Study"
  scholarClass  String?  // e.g. "SCHOLAR", "ANALYST", "ENGINEER", "SCIENTIST", "RESEARCHER", "PSYCHOLOGIST", "STRATEGIST", "CREATIVE"
  referralCode  String   @unique
  referredBy    String?  // referralCode of who referred them
  referralCount Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([email])
  @@index([referralCode])
  @@index([createdAt(sort: Desc)])
}

