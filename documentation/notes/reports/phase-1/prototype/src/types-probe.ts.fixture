import{BlockNoteEditor}from'@blocknote/core';import{withCollaboration}from'@blocknote/core/yjs';import * as Y from'yjs';import Dexie from'dexie';import{getStroke}from'perfect-freehand';import{getDocument}from'pdfjs-dist';const doc=new Y.Doc();const options=withCollaboration({collaboration:{fragment:doc.getXmlFragment('body'),user:{name:'test',color:'#123456'}}});export function browserOnly(){return{editor:BlockNoteEditor.create(options),database:new Dexie('isolated'),stroke:getStroke([[0,0,0.5]]),pdf:getDocument({data:new Uint8Array()})}}
