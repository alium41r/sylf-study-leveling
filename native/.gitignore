# Dependencies and generated output for the Sylf Native workspace.
node_modules/
dist/
web-build/
.expo/
*.tsbuildinfo
coverage/

# Continuous Native Generation: android/ and ios/ are regenerated by `expo prebuild`.
apps/sylf/android/
apps/sylf/ios/

# Local environment and signing material never belongs in the repository.
.env*.local
*.keystore
!debug.keystore
*.jks
*.p8
*.p12
*.mobileprovision

# Native module build output.
packages/*/android/build/
packages/*/android/.gradle/
