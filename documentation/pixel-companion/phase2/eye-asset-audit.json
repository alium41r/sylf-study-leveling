      "width": 1254,
      "height": 1254
    },
    "canonicalLayerOrigin": {
      "x": 0,
      "y": 0
    },
    "embeddedEyeRegion": {
      "left": 475,
      "top": 480,
      "width": 300,
      "height": 150
    },
    "sourceEyeScaleRelativeToBaseSource": 0.5,
    "nativeBaseEyeAnchors": [
      {
        "x": 550,
        "y": 555
      },
      {
        "x": 700,
        "y": 555
      }
    ],
    "pixelRendering": "Every layer fills the same canvas at (0,0). The renderer applies identical pixelated display scaling to body and eye layers; there are no CSS offsets or per-expression scales."
  },
  "alphaModification": "No background removal or alpha-value interpolation. Each retained runtime alpha is copied from a selected source sample; surrounding padding is transparent. The source artwork already contains transparency.",
  "nearestSampling": {
    "sourceDimensions": {
      "width": 600,
      "height": 300
    },
    "destinationDimensions": {
      "width": 300,
      "height": 150
    },
    "formula": "sourceX = 2*destinationX+1; sourceY = 2*destinationY+1; copy the whole RGBA tuple",
    "lossless": false,
    "explanation": "Sampling discards source pixels rather than recovering a lossless logical grid. It preserves the selected artwork's palette and intended body-space scale, but must not be described as unresampled or pixel-for-pixel source preservation."
  },
