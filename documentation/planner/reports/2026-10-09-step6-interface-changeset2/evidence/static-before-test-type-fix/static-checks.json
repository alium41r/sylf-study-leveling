[
  {
    "name": "isolated-typecheck",
    "command": [
      "node",
      "node_modules/typescript/bin/tsc",
      "-p",
      "tsconfig.planner-v2-phase2.json",
      "--incremental",
      "false"
    ],
    "exitCode": 2
  },
  {
    "name": "full-typecheck",
    "command": [
      "node",
      "node_modules/typescript/bin/tsc",
      "--noEmit",
      "--incremental",
      "false"
    ],
    "exitCode": 2
  },
  {
    "name": "lint",
    "command": [
      "node",
      "node_modules/eslint/bin/eslint.js",
      "lib/planner/v2/intelligence/quality.ts",
      "lib/planner/v2/intelligence/provider.ts",
      "lib/planner/v2/intelligence/blueprint.ts",
      "lib/planner/v2/intelligence/schemas/quality.ts",
      "lib/planner/v2/server/learning.ts",
      "lib/planner/v2/server/compiler.ts",
      "__tests__/planner-v2/intelligence/provider.test.ts",
      "__tests__/planner-v2/intelligence/quality.test.ts",
      "__tests__/planner-v2/intelligence/review-recovery.test.ts",
      "__tests__/planner-v2/intelligence/review-fixtures.ts",
      "__tests__/planner-v2/postgres/compiler-quality.postgres.ts",
      "--max-warnings",
      "0"
    ],
    "exitCode": 0
  },
  {
    "name": "worker-build",
    "command": [
      "npm",
      "run",
      "planner:worker:build"
    ],
    "exitCode": 0
  }
]
