 will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[8120,8123],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":292,"column":42,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":292,"endColumn":45,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[8984,8987],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[8984,8987],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":339,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":339,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[10679,10682],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[10679,10682],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":12,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  LLMAdapter,\n  NormalizedMessage,\n  NormalizedTool,\n  LLMResponse,\n  LLMProviderError,\n  NormalizedToolCall,\n} from \"./types\";\nimport crypto from \"crypto\";\n\nexport interface DeepSeekAdapterOptions {\n  responseFormat?: \"json_object\" | \"text\";\n  temperature?: number;\n  maxTokens?: number;\n  /**\n   * Toggles DeepSeek's thinking/reasoning mode for models that support it\n   * (deepseek-chat / deepseek-reasoner, V3.1+). \"disabled\" skips generating\n   * and billing reasoning tokens — used for simple/fast tiers. If the API\n   * rejects the param, the request retries automatically without it.\n   */\n  thinking?: \"enabled\" | \"disabled\";\n  /** Aborts the upstream HTTP request immediately when signalled. */\n  signal?: AbortSignal;\n  /** Caller owns the bounded repair/fallback budget. */\n  singleAttempt?: boolean;\n}\n\nexport class DeepSeekAdapter implements LLMAdapter {\n  private apiKey: string;\n  private model: string;\n  private baseURL: string;\n\n  constructor(\n    apiKey: string,\n    model: string = \"deepseek-v4-flash\",\n    baseURL: string = process.env.DEEPSEEK_BASE_URL || \"https://api.deepseek.com\"\n  ) {\n    // Sanitize API key and baseURL against zero-width spaces (\\u200B) or non-ASCII characters\n    this.apiKey = (apiKey || \"\").replace(/[^\\x20-\\x7E]/g, \"\").trim();\n    this.model = model;\n    this.baseURL = (baseURL || \"https://api.deepseek.com\")\n      .replace(/[^\\x20-\\x7E]/g, \"\")\n      .trim()\n      .replace(/\\/+$/, \"\");\n  }\n\n  public getModel(): string {\n    return this.model;\n  }\n\n  public resolveModelName(requested: string): string {\n    if (process.env.DEEPSEEK_MODEL) return process.env.DEEPSEEK_MODEL;\n    if (requested.includes(\"vision\")) return \"deepseek-v4-flash-vision-exp\";\n    if (requested.includes(\"reasoner\")) return \"deepseek-reasoner\";\n    return requested || \"deepseek-v4-flash\";\n  }\n\n  private mapTool(tool: NormalizedTool): any {\n    return {\n      type: \"function\",\n      function: {\n        name: tool.name,\n        description: tool.description,\n        parameters: tool.parameters || { type: \"object\", properties: {} },\n      },\n    };\n  }\n\n  private mapMessages(\n    messages: NormalizedMessage[],\n    systemInstruction: string\n  ): any[] {\n    const deepSeekMessages: any[] = [];\n\n    // DeepSeek OpenAI-compatible standard requires system message\n    if (systemInstruction && systemInstruction.trim().length > 0) {\n      deepSeekMessages.push({\n        role: \"system\",\n        content: systemInstruction.trim(),\n      });\n    }\n\n    for (const msg of messages) {\n      if (msg.role === \"system\") {\n        if (msg.content) {\n          deepSeekMessages.push({ role: \"system\", content: msg.content });\n        }\n        continue;\n      }\n\n      if (msg.role === \"user\") {\n        const hasMedia = msg.parts?.some((p) => !!p.inlineData);\n\n        if (hasMedia && msg.parts) {\n          const contentParts: any[] = [];\n          for (const p of msg.parts) {\n            if (p.text) {\n              contentParts.push({ type: \"text\", text: p.text });\n            }\n            if (p.inlineData) {\n              contentParts.push({\n                type: \"image_url\",\n                image_url: {\n                  url: `data:${p.inlineData.mimeType};base64,${p.inlineData.data}`,\n                },\n              });\n            }\n          }\n          if (msg.content && !msg.parts.some((p) => p.text === msg.content)) {\n            contentParts.unshift({ type: \"text\", text: msg.content });\n          }\n          deepSeekMessages.push({ role: \"user\", content: contentParts });\n        } else {\n          let text = msg.content || \"\";\n          if (msg.parts) {\n            const partsText = msg.parts\n              .map((p) => p.text)\n              .filter(Boolean)\n              .join(\"\\n\");\n            if (partsText) {\n              text = text ? `${text}\\n${partsText}` : partsText;\n            }\n          }\n          deepSeekMessages.push({ role: \"user\", content: text || \" \" });\n        }\n      } else if (msg.role === \"assistant\") {\n        if (msg.toolCalls && msg.toolCalls.length > 0) {\n          deepSeekMessages.push({\n            role: \"assistant\",\n            content: msg.content || null,\n            tool_calls: msg.toolCalls.map((tc) => ({\n              id: tc.id || `call_${crypto.randomUUID().slice(0, 8)}`,\n              type: \"function\",\n              function: {\n                name: tc.name,\n                arguments:\n                  typeof tc.args === \"string\"\n                    ? tc.args\n                    : JSON.stringify(tc.args || {}),\n              },\n            })),\n          });\n        } else {\n          deepSeekMessages.push({\n            role: \"assistant\",\n            content: msg.content || \"\",\n          });\n        }\n      } else if (msg.role === \"tool\") {\n        if (msg.toolResults && msg.toolResults.length > 0) {\n          for (const tr of msg.toolResults) {\n            deepSeekMessages.push({\n              role: \"tool\",\n              tool_call_id: tr.toolCallId,\n              name: tr.name,\n              content:\n                typeof tr.result === \"string\"\n                  ? tr.result\n                  : JSON.stringify(tr.result),\n            });\n          }\n        }\n      }\n    }\n\n    return deepSeekMessages;\n  }\n\n  async generateResponse(\n    messages: NormalizedMessage[],\n    systemInstruction: string,\n    tools: NormalizedTool[] = [],\n    options?: DeepSeekAdapterOptions\n  ): Promise<LLMResponse> {\n    if (!this.apiKey) {\n      throw new LLMProviderError(\n        \"deepseek\",\n        \"DEEPSEEK_API_KEY is not configured.\",\n        null,\n        \"missing_api_key\"\n      );\n    }\n\n    const deepSeekMessages = this.mapMessages(messages, systemInstruction);\n    const deepSeekTools =\n      tools.length > 0 ? tools.map((t) => this.mapTool(t)) : undefined;\n\n    const targetModel = this.resolveModelName(this.model);\n    const payload: Record<string, any> = {\n      model: targetModel,\n      messages: deepSeekMessages,\n      stream: false,\n    };\n\n    if (deepSeekTools && deepSeekTools.length > 0) {\n      payload.tools = deepSeekTools;\n      payload.tool_choice = \"auto\";\n    }\n\n    if (options?.responseFormat === \"json_object\") {\n      payload.response_format = { type: \"json_object\" };\n    }\n\n    if (typeof options?.temperature === \"number\") {\n      payload.temperature = options.temperature;\n    }\n\n    if (typeof options?.maxTokens === \"number\") {\n      payload.max_tokens = options.maxTokens;\n    }\n\n    if (options?.thinking) {\n      payload.thinking = { type: options.thinking };\n    }\n\n    const doRequest = async (reqPayload: Record<string, any>): Promise<any> => {\n      const endpoint = `${this.baseURL}/chat/completions`;\n      const response = await fetch(endpoint, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          Authorization: `Bearer ${this.apiKey}`,\n        },\n        body: JSON.stringify(reqPayload),\n        signal: options?.signal,\n      });\n\n      if (!response.ok) {\n        let errorBody = \"\";\n        try {\n          errorBody = await response.text();\n        } catch {\n          // ignore\n        }\n\n        const statusCode = response.status;\n        let errorCode = \"api_error\";\n        if (statusCode === 401) errorCode = \"unauthorized\";\n        else if (statusCode === 429) errorCode = \"rate_limit\";\n        else if (statusCode >= 500) errorCode = \"server_error\";\n\n        const err = new LLMProviderError(\n          \"deepseek\",\n          `DeepSeek API responded with HTTP ${statusCode}: ${errorBody || response.statusText}`,\n          errorBody,\n          errorCode\n        ) as LLMProviderError & { status: number };\n        err.status = statusCode;\n        throw err;\n      }\n\n      return response.json();\n    };\n\n    try {\n      let data: any;\n      try {\n        data = await doRequest(payload);\n      } catch (err: any) {\n        // If the deployed model doesn't accept the `thinking` param, retry\n        // once without it instead of cascading to fallback providers.\n        if (\n          !options?.singleAttempt && options?.thinking &&\n          err instanceof LLMProviderError &&\n          (err as any).status === 400 &&\n          typeof err.originalError === \"string\" &&\n          /thinking/i.test(err.originalError)\n        ) {\n          console.warn(\"[DeepSeek] 'thinking' param rejected by the API — retrying without it.\");\n          delete payload.thinking;\n          data = await doRequest(payload);\n        } else {\n          throw err;\n        }\n      }\n\n      const choice = data.choices?.[0];\n      const message = choice?.message;\n\n      if (!message) {\n        throw new LLMProviderError(\n          \"deepseek\",\n          \"DeepSeek API returned an empty choices array.\",\n          data,\n          \"empty_response\"\n        );\n      }\n\n      const normalizedToolCalls: NormalizedToolCall[] = [];\n      if (message.tool_calls && Array.isArray(message.tool_calls)) {\n        for (const tc of message.tool_calls) {\n          let parsedArgs: Record<string, any> = {};\n          try {\n            parsedArgs =\n              typeof tc.function?.arguments === \"string\"\n                ? JSON.parse(tc.function.arguments || \"{}\")\n                : tc.function?.arguments || {};\n          } catch (err) {\n            throw new LLMProviderError(\n              \"deepseek\",\n              `Failed to parse tool call arguments for tool '${tc.function?.name}'`,\n              err,\n              \"invalid_json\"\n            );\n          }\n\n          normalizedToolCalls.push({\n            id: tc.id || crypto.randomUUID(),\n            name: tc.function?.name || \"\",\n            args: parsedArgs,\n          });\n        }\n      }\n\n      const rawText = message.content || \"\";\n      const reasoningContent = message.reasoning_content;\n\n      // If reasoning_content exists (DeepSeek Reasoner), log or preserve reasoning\n      const text = rawText ? rawText.trim() : undefined;\n\n      return {\n        finishReason: data.choices?.[0]?.finish_reason === \"length\" ? \"MAX_TOKENS\" :\n          [\"stop\", \"tool_calls\"].includes(data.choices?.[0]?.finish_reason) ? \"STOP\" : \"OTHER\",\n        text,\n        toolCalls:\n          normalizedToolCalls.length > 0 ? normalizedToolCalls : undefined,\n        rawCandidateParts: reasoningContent\n          ? [{ text: reasoningContent, type: \"reasoning\" }]\n          : undefined,\n        usage: data.usage\n          ? {\n              promptTokens: data.usage.prompt_tokens || 0,\n              completionTokens: data.usage.completion_tokens || 0,\n              totalTokens: data.usage.total_tokens || 0,\n              cacheHitTokens: data.usage.prompt_cache_hit_tokens || 0,\n            }\n          : undefined,\n      };\n    } catch (err: any) {\n      if (err instanceof LLMProviderError) {\n        throw err;\n      }\n      throw new LLMProviderError(\n        \"deepseek\",\n        `DeepSeek network or execution error: ${err.message || String(err)}`,\n        err,\n        \"network_error\"\n      );\n    }\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/aliumair/Desktop/sylf/lib/ai/providers/groq.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":14,"column":42,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":14,"endColumn":45,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[485,488],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[485,488],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":25,"column":82,"nodeType":"TSAnyKeyword