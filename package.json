{
  "name": "sylf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "sylv:vectorize": "node scripts/pipeline-vectorize-sylvs.mjs",
    "sylv:optimize": "node scripts/optimize-sylv-svgs.mjs",
    "seed": "npx tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "audit:secrets": "node scripts/scan-secrets.mjs",
    "audit:models": "node scripts/check-model-migration.mjs",
    "mobile:dev": "vite mobile",
    "mobile:build": "vite build mobile",
    "mobile:build:mock": "VITE_ENABLE_MOCK_API=true vite build mobile",
    "mobile:verify": "node scripts/verify-mobile-bundle.mjs",
    "mobile:verify:mock": "node scripts/verify-mobile-bundle.mjs --mock",
    "android:sync": "npm run mobile:build && npm run mobile:verify && cap sync android",
    "android:sync:mock": "npm run mobile:build:mock && npm run mobile:verify:mock && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:build:mock": "npm run android:sync:mock && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:run:mock": "npm run android:sync:mock && cap run android",
    "planner:worker:build": "node scripts/build-planner-worker.mjs",
    "planner:worker": "node dist/planner-worker/main.js",
    "planner:dev": "npm run planner:worker:build && node scripts/dev-planner.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@google/genai": "^2.10.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.112.4",
    "@upstash/redis": "^1.38.2",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.4.1",
    "groq-sdk": "^1.5.0",
    "jose": "^6.2.3",
    "katex": "^0.18.4",
    "lucide-react": "^1.31.0",
    "next": "16.2.9",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@faker-js/faker": "^9.5.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@visioncortex/vtracer": "^1.0.0-alpha.4",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "prisma": "^7.8.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": "24.x"
  }
}
