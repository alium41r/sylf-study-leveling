c":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3731,3734],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'err' is defined but never used.","line":163,"column":22,"nodeType":"Identifier","messageId":"unusedVar","endLine":163,"endColumn":25},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":163,"column":27,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":163,"endColumn":30,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[5670,5673],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[5670,5673],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":188,"column":23,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":188,"endColumn":26,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6813,6816],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6813,6816],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'e' is defined but never used.","line":203,"column":22,"nodeType":"Identifier","messageId":"unusedVar","endLine":203,"endColumn":23}],"suppressedMessages":[],"errorCount":7,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import Groq from \"groq-sdk\";\nimport { LLMAdapter, NormalizedMessage, NormalizedTool, LLMResponse, LLMProviderError, NormalizedToolCall } from \"./types\";\nimport crypto from \"crypto\";\n\nexport class GroqAdapter implements LLMAdapter {\n  private groq: Groq;\n  private model: string;\n\n  constructor(apiKey: string, model: string = process.env.GROQ_MODEL || \"openai/gpt-oss-120b\") {\n    this.groq = new Groq({ apiKey });\n    this.model = model;\n  }\n\n  private mapTool(tool: NormalizedTool): any {\n    return {\n      type: \"function\",\n      function: {\n        name: tool.name,\n        description: tool.description,\n        parameters: tool.parameters || { type: \"object\", properties: {} },\n      },\n    };\n  }\n\n  private mapMessages(messages: NormalizedMessage[], systemInstruction: string): any[] {\n    const groqMessages: any[] = [];\n    \n    // Groq requires system instruction as the first message\n    groqMessages.push({ role: \"system\", content: systemInstruction });\n\n    for (const msg of messages) {\n      if (msg.role === \"system\") continue;\n\n      if (msg.role === \"user\") {\n        if (msg.parts && msg.parts.some((p) => p.inlineData)) {\n          const contentParts: any[] = [];\n          for (const p of msg.parts) {\n            if (p.text) contentParts.push({ type: \"text\", text: p.text });\n            if (p.inlineData) {\n              contentParts.push({\n                type: \"image_url\",\n                image_url: {\n                  url: `data:${p.inlineData.mimeType};base64,${p.inlineData.data}`,\n                },\n              });\n            }\n          }\n          if (contentParts.length === 0 && msg.content) {\n            contentParts.push({ type: \"text\", text: msg.content });\n          }\n          groqMessages.push({ role: \"user\", content: contentParts });\n        } else {\n          let content = msg.content || \"\";\n          if (msg.parts) {\n            for (const p of msg.parts) {\n              if (p.text) content += (content ? \"\\n\" : \"\") + p.text;\n            }\n          }\n          groqMessages.push({ role: \"user\", content: content || \" \" });\n        }\n      } else if (msg.role === \"assistant\") {\n        if (msg.toolCalls) {\n          groqMessages.push({\n            role: \"assistant\",\n            content: msg.content || \"\",\n            tool_calls: msg.toolCalls.map(tc => ({\n              id: tc.id,\n              type: \"function\",\n              function: { name: tc.name, arguments: JSON.stringify(tc.args) }\n            }))\n          });\n        } else {\n          groqMessages.push({ role: \"assistant\", content: msg.content || \"\" });\n        }\n      } else if (msg.role === \"tool\") {\n        if (msg.toolResults) {\n          for (const tr of msg.toolResults) {\n            groqMessages.push({\n              role: \"tool\",\n              tool_call_id: tr.toolCallId,\n              name: tr.name,\n              content: typeof tr.result === \"string\" ? tr.result : JSON.stringify(tr.result),\n            });\n          }\n        }\n      }\n    }\n\n    return groqMessages;\n  }\n\n  async generateResponse(\n    messages: NormalizedMessage[],\n    systemInstruction: string,\n    tools: NormalizedTool[],\n    options?: import(\"./types\").LLMGenerateOptions\n  ): Promise<LLMResponse> {\n    const groqMessages = this.mapMessages(messages, systemInstruction);\n    const groqTools = tools.length > 0 ? tools.map(this.mapTool) : undefined;\n\n    const candidateModels = options?.singleAttempt ? [this.model] : Array.from(\n      new Set(\n        [\n          this.model,\n          process.env.GROQ_MODEL,\n          \"openai/gpt-oss-120b\",\n          \"openai/gpt-oss-20b\",\n          \"llama-3.3-70b-versatile\",\n          \"qwen/qwen3.8-27b\",\n        ].filter(Boolean) as string[]\n      )\n    );\n\n    let lastError: any = null;\n\n    for (const modelToTry of candidateModels) {\n      try {\n        const completion = await this.groq.chat.completions.create({\n          model: modelToTry,\n          messages: groqMessages,\n          tools: groqTools,\n          tool_choice: groqTools ? \"auto\" : undefined,\n          response_format:\n            options?.responseFormat === \"json_object\"\n              ? { type: \"json_object\" }\n              : undefined,\n          temperature: options?.temperature,\n          max_tokens: options?.maxTokens,\n        }, {\n          signal: options?.signal,\n          ...(options?.singleAttempt ? { maxRetries: 0 } : {}),\n        });\n\n        const responseMessage = completion.choices[0].message;\n        const normalizedToolCalls: NormalizedToolCall[] = [];\n\n        // 1. Standard Tool Calls\n        if (responseMessage.tool_calls && responseMessage.tool_calls.length > 0) {\n          for (const tc of responseMessage.tool_calls) {\n            let args = {};\n            try {\n              args = JSON.parse(tc.function.arguments || \"{}\");\n            } catch (e) {\n              throw new LLMProviderError(\"groq\", \"Failed to parse tool arguments from Groq\", e, \"invalid_json\");\n            }\n            normalizedToolCalls.push({\n              id: tc.id,\n              name: tc.function.name,\n              args,\n            });\n          }\n        } \n        // 2. Llama-3 XML Recovery Logic\n        else if (responseMessage.content && responseMessage.content.includes(\"<function\")) {\n          const matches = [...responseMessage.content.matchAll(/<function[=(](\\w+)[=)>]*([\\s\\S]*?)<\\/function>/gi)];\n          for (const match of matches) {\n            const toolName = match[1];\n            const rawArgs = match[2];\n            let args = {};\n            try {\n              const cleanedArgs = rawArgs.replace(/^[=\\s>]+/, \"\").trim();\n              args = JSON.parse(cleanedArgs || \"{}\");\n            } catch (err: any) {\n               // We swallow parsing errors here to let it fail upstream gracefully\n            }\n            normalizedToolCalls.push({\n              id: crypto.randomUUID(), // Groq didn't provide one since it hallucinated\n              name: toolName,\n              args,\n            });\n          }\n        }\n\n        const rawContent = responseMessage.content || undefined;\n        const cleanContent = rawContent ? rawContent.replace(/<think>[\\s\\S]*?<\\/think>/gi, \"\").trim() : undefined;\n\n        return {\n          finishReason: completion.choices?.[0]?.finish_reason === \"length\" ? \"MAX_TOKENS\" :\n            [\"stop\", \"tool_calls\"].includes(completion.choices?.[0]?.finish_reason ?? \"\") ? \"STOP\" : \"OTHER\",\n          text: cleanContent || undefined,\n          toolCalls: normalizedToolCalls.length > 0 ? normalizedToolCalls : undefined,\n          usage: completion.usage ? {\n            promptTokens: completion.usage.prompt_tokens || 0,\n            completionTokens: completion.usage.completion_tokens || 0,\n            totalTokens: completion.usage.total_tokens || 0,\n          } : undefined,\n        };\n      } catch (error: any) {\n        lastError = error;\n\n        // Handle the Llama-3 400 error where it throws raw XML back at the API\n        const groqInnerError = error.error?.error;\n        if (!options?.singleAttempt && groqInnerError?.code === \"tool_use_failed\" && groqInnerError?.failed_generation) {\n          const failedGen = groqInnerError.failed_generation;\n          const match = failedGen.match(/<function[=(](\\w+)[=)>]*([\\s\\S]*?)<\\/function>/i);\n          if (match) {\n            const toolName = match[1];\n            const rawArgs = match[2];\n            let args = {};\n            try {\n              const cleanedArgs = rawArgs.replace(/^[=\\s>]+/, \"\").trim();\n              args = JSON.parse(cleanedArgs || \"{}\");\n            } catch (e) {}\n\n            return {\n              toolCalls: [{\n                id: crypto.randomUUID(),\n                name: toolName,\n                args,\n              }]\n            };\n          }\n        }\n\n        // If error is model_not_found, 404, or decommissioned, try next candidate model\n        const isModelNotFound =\n          error.status === 404 ||\n          groqInnerError?.code === \"model_not_found\" ||\n          groqInnerError?.code === \"model_decommissioned\" ||\n          (error.message && (\n            error.message.includes(\"model_not_found\") ||\n            error.message.includes(\"model_decommissioned\") ||\n            error.message.includes(\"decommissioned\")\n          ));\n\n        if (!isModelNotFound) {\n          throw new LLMProviderError(\n            \"groq\",\n            error.message || \"Failed to generate Groq response\",\n            error,\n            groqInnerError?.code\n          );\n        }\n      }\n    }\n\n    const groqInnerError = lastError?.error?.error;\n    throw new LLMProviderError(\n      \"groq\",\n      lastError?.message || \"Failed to generate Groq response across available models\",\n      lastError,\n      groqInnerError?.code\n    );\n  }\n}\n","usedDeprecatedRules":[]}]
